#!name = vukenzo - All In One Pro Max
#!desc = Module gộp YouTube Premium, Locket Gold và Spotify độc lập bởi vukenzo.
#!author = vukenzo

[Rule]
# --- YouTube Rules ---
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT

# --- Spotify Rules ---
AND,((DOMAIN-SUFFIX, spotify.com), (PROTOCOL, QUIC)),REJECT
DOMAIN,aet.spotify.com,REJECT

[URL Rewrite]
# --- YouTube Rewrites ---
'(^https?://[\w-]+\.googlevideo\.com/(?!dclk_video_ads).+?)&ctier=L(&.+?),ctier,(.+)' $1$2$3 302
'^https?://[\w-]+\.googlevideo\.com/(?!(?:dclk_video_ads|videoplayback\?)).+&oad' _ reject-200
'^https?://(?:www|s)\.youtube\.com/api/stats/ads' _ reject-200
'^https?://(?:www|s)\.youtube\.com/(?:pagead|ptracking)' _ reject-200
'^https?://s\.youtube\.com/api/stats/qoe\?adcontext' _ reject-200

# --- Spotify Rewrites ---
^https:\/\/(spclient\.wg|.*-spclient)\.spotify\.com(:443)?\/pendragon - reject
^https:\/\/.*-spclient\.spotify\.com(:443)?\/pam-view-service\/ - reject
^https:\/\/.*37i9dQZF1EYkqdzj48dyYq - reject

[Header Rewrite]
http-request ^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/user-customization-service\/v1\/customize$ header-del if-none-match

[Script]
# --- YouTube Premium ---
youtube_response = type=http-response,pattern=^https://youtubei\.googleapis\.com/youtubei/v1/(?:browse|next|player|search|reel/reel_watch_sequence|guide|account/get_setting|get_watch)(?:[/?#]|$),requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://cdn.jsdelivr.net/gh/akiralereal/shadowrocket-toolkit@main/scripts/youtube-response.js,argument="{}"

# --- Locket Gold ---
revenuecat = type=http-response,pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$),requires-body=true,max-size=-1,timeout=60,script-path=https://cdn.jsdelivr.net/gh/vuong2023/shad@main/js/Locket_Ohoang7.js
deleteHeader = type=http-request,pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers),script-path=https://cdn.jsdelivr.net/gh/vuong2023/shad@main/js/deleteHeader.js,timeout=60

# --- Spotify Scripts ---
spotify-search = type=http-response,pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/browsita\/v.\/browse,requires-body=1,binary-body-mode=1,max-size=0,script-path=https://raw.githubusercontent.com/Reukix/ukix/refs/heads/main/js/Spotify-search.js
spotify-scroll = type=http-response,pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/scrollsita\/v.\/scroll\/spotify,requires-body=1,binary-body-mode=1,max-size=0,script-path=https://raw.githubusercontent.com/Reukix/ukix/refs/heads/main/js/Spotify-scroll.js
spotify-gabo = type=http-request,pattern=^https:\/\/(.*-spclient\.spotify\.com(:443)?|spclient\.wg\.spotify\.com)\/gabo-receiver-service,requires-body=0,script-path=https://raw.githubusercontent.com/Reukix/ukix/refs/heads/main/js/Spotify-gabo.js
spotify-proto = type=http-response,pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)$,requires-body=1,binary-body-mode=1,max-size=0,script-path=https://raw.githubusercontent.com/Reukix/ukix/refs/heads/main/js/Spotify-proto.js,script-update-interval=0

[MITM]
ca-passphrase = zFDVAzoe
ca-p12 = 
enable = true
hostname = %APPEND% *.googlevideo.com, youtubei.googleapis.com, www.youtube.com, s.youtube.com, -redirector*.googlevideo.com, api.revenuecat.com, spclient.wg.spotify.com, *spclient.spotify.com
